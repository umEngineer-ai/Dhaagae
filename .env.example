# DHAAGAÉ Environment Configuration Example
# Database Connection (SQLite default for local instant zero-setup; or PostgreSQL for cloud deployment)
DATABASE_URL="file:./dev.db"

# Authentication & Sessions
AUTH_SECRET="your-super-secret-jwt-key-replace-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Integrations (OpenAI GPT & DALL-E)
AI_API_KEY="your-openai-api-key"
IMAGE_GENERATION_API_KEY=""

# Payments
PAYMENT_API_KEY=""
PAYMENT_SECRET=""
PAYMENT_PROVIDER="COD"
# Keep gateway credentials server-side; online checkout remains disabled until configured.
CARD_GATEWAY_SECRET=""
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
EASYPAISA_STORE_ID=""
EASYPAISA_PRIVATE_KEY=""

# Email Notifications (Resend)
EMAIL_API_KEY="your-resend-api-key"
